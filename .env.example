# ---------------------------------------------------------------------------
# InsightForge - environment configuration
# Copy to .env and fill in the values. Never commit the filled .env.
# ---------------------------------------------------------------------------

# ---- Supabase -------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Public anon/publishable key. Used by the frontend sign-in form and by the
# backend to verify access tokens.
SUPABASE_ANON_KEY=

# SECRET service-role key. Backend only - it bypasses row-level security and
# must never be exposed to the frontend or the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM ------------------------------------------------------------------
# Groq API key (https://console.groq.com/keys).
GROQ_API_KEY=

# ---- Retrieval ------------------------------------------------------------
# Cosine-similarity cut-off for pgvector matches. Leave blank for the default
# (0.05); MiniLM scores are compressed, so values above ~0.25 drop good chunks.
# Only used by the pgvector-only fallback path.
MATCH_THRESHOLD=

# RRF damping constant for hybrid retrieval; 60 is the value from the RRF paper.
# Example: 60
HYBRID_RRF_K=

# ---- Networking -----------------------------------------------------------
# Exact browser origins allowed to call the API (CORS), comma-separated.
# Scheme + host + optional port only: no paths, no trailing slash, no "*".
# When blank the code uses localhost:8501, 127.0.0.1:8501 and the deployed
# Streamlit app. Example: https://insightforge.example.com,http://localhost:8501
ALLOWED_ORIGINS=

# Base URL of the FastAPI service, used by the Streamlit frontend.
# Example: https://insightforge-api.onrender.com
BACKEND_URL=
# Public URL of the Streamlit app; used as the sign-up confirmation redirect.
APP_URL=

# ---- Optional tuning ------------------------------------------------------
# MODEL_NAME / GROQ_MODEL   default: openai/gpt-oss-20b
# MAX_UPLOAD_MB             default: 15   (PDF upload cap)
# MAX_DATASET_MB            default: 10   (CSV upload cap)
# MAX_CSV_ROWS              default: 100000
# MAX_CSV_COLUMNS           default: 50
# MAX_PDF_PAGES             default: 50
# REQUEST_TIMEOUT           default: 180  (frontend, seconds)
# RATE_LIMIT_UPLOAD         default: 5/minute
# RATE_LIMIT_QA             default: 10/minute
# RATE_LIMIT_ANOMALIES      default: 10/minute
# RATE_LIMIT_AGENT          default: 10/minute
