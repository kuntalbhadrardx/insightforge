# ---------------------------------------------------------------------------
# InsightForge environment configuration
#
# Copy to .env, fill in your own values, and never commit the result.
#   cp .env.example .env
#
# The backend reads .env from the repository root. Vite only exposes variables
# prefixed VITE_, so copy those three lines into frontend/.env as well.
#
# Every value below is a placeholder. None of them will work as-is.
# ---------------------------------------------------------------------------

# ---- Supabase (required) --------------------------------------------------
# Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key: verifies the access tokens the frontend sends.
SUPABASE_ANON_KEY=your-anon-key-here
# SECRET service-role key. Server-side only: it bypasses row-level security and
# must never reach the browser, a log line or a commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Frontend (required, also copy these into frontend/.env) --------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Where the browser finds the API. Defaults to http://localhost:8000.
VITE_API_URL=http://localhost:8000

# ---- LLM (required) -------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Default: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# ---- CORS -----------------------------------------------------------------
# Exact browser origins allowed to call the API, comma-separated. Scheme, host
# and optional port only: no paths, no trailing slash, no "*".
# Example: https://insightforge.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=
# Regex for generated preview URLs. Default:
# ^https://insightforge(?:-[a-z0-9-]+)?\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# ---- Retrieval ------------------------------------------------------------
# Cosine cut-off for the pgvector fallback. Default 0.05; MiniLM scores are
# compressed, so anything above ~0.25 drops good chunks.
MATCH_THRESHOLD=0.05
MATCH_COUNT=6
# RRF damping constant; 60 is the value from the RRF paper.
HYBRID_RRF_K=60
# Chunk geometry. Windows never cross a page boundary, which keeps citations
# honest.
CHUNK_SIZE_WORDS=500
CHUNK_OVERLAP_WORDS=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MAX_SEQ_LENGTH=512

# ---- Upload and ingest caps ----------------------------------------------
MAX_UPLOAD_MB=15
MAX_DATASET_MB=10
MAX_CSV_ROWS=100000
MAX_CSV_COLUMNS=50
MAX_PDF_PAGES=50
MAX_CACHED_DATAFRAMES=50
CHAT_HISTORY_LIMIT=500

# ---- Rate limits (slowapi syntax) ----------------------------------------
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_QA=10/minute
RATE_LIMIT_ANOMALIES=10/minute
RATE_LIMIT_AGENT=10/minute
RATE_LIMIT_CHAT=60/minute

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
